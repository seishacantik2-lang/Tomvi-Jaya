// === akhir pengaturan ===
var price=function(b){return Math.round(b*(1+MARKUP)/ROUND)*ROUND};
var rp=function(n){return "Rp "+Number(n).toLocaleString("id-ID")};
var cart={}, cat="", query="", user=null, vip=[], TOKEN="";
var EMO={}; EMO[K]="🧀"; EMO[S]="🥛";
function g(id){return document.getElementById(id)}
function esc(s){return String(s==null?'':s).replace(/[&<>"]/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]})}
function normal(nama,satuan){
  for(var i=0;i<D.length;i++){if(D[i][0]===nama){for(var j=0;j<D[i][2].length;j++){if(D[i][2][j][1]===satuan)return price(D[i][2][j][0])}}}
  return 0;
}
function card(x){
  var d=x.d;
  return '<div class="card"><div class="ph" aria-hidden="true">'+EMO[d[1]]+'<u>Foto menyusul</u></div><h3>'+esc(d[0])+'</h3>'+
  d[2].map(function(t,j){return '<div class="tier"><span><b>'+rp(price(t[0]))+'</b> <small>/'+esc(t[1])+'</small></span><button class="add" aria-label="Tambah '+esc(d[0])+' per '+esc(t[1])+'" data-add="'+x.i+'-'+j+'">+</button></div>'}).join("")+'</div>';
}
function vipCard(v,i){
  var n=normal(v.nama,v.satuan),h=Number(v.harga)||0;
  return '<div class="card"><div class="ph" aria-hidden="true">'+(EMO[v.kategori]||'⭐')+'<u>Harga istimewa</u></div><h3>'+esc(v.nama)+'</h3>'+
  '<div class="tier"><span><b>'+rp(h)+'</b> <small>/'+esc(v.satuan)+'</small>'+(n>h?'<br><small><s>'+rp(n)+'</s> harga normal</small>':'')+'</span>'+
  '<button class="add" aria-label="Tambah '+esc(v.nama)+'" data-add="v-'+i+'">+</button></div></div>';
}
function render(){
  var chips=[["","✨ Semua"],[K,"🧀 "+K],[S,"🥛 "+S]];
  g("chips").innerHTML=chips.map(function(c){return '<button class="chip'+(cat===c[0]?' on':'')+'" data-cat="'+c[0]+'">'+c[1]+'</button>'}).join("");
  var all=D.map(function(d,i){return {d:d,i:i}});
  var out="";
  if(user){
    out='<div class="vipsec"><div class="sec"><h2>⭐ Harga istimewa untuk '+esc(user.nama)+'</h2></div>'+
      (vip.length?'<div class="grid">'+vip.map(vipCard).join("")+'</div>':'<p class="empty">Belum ada harga istimewa untuk akunmu. Hubungi admin.</p>')+'</div>';
  } else if(cat||query){
    var list=all.filter(function(x){return (!cat||x.d[1]===cat)&&(!query||x.d[0].toLowerCase().indexOf(query)>-1)});
    out='<div class="sec"><h2>'+(cat||"Hasil pencarian")+'</h2><span class="empty">'+list.length+' produk</span></div>'+
      (list.length?'<div class="grid">'+list.map(card).join("")+'</div>':'<p class="empty">Produk tidak ditemukan. Coba kata kunci lain.</p>');
  } else {
    [K,S].forEach(function(c){
      var l=all.filter(function(x){return x.d[1]===c});
      out+='<div class="sec"><h2>'+c+'</h2><button data-cat="'+c+'">Lihat semua ('+l.length+') →</button></div><div class="grid">'+l.slice(0,4).map(card).join("")+'</div>';
    });
  }
  g("content").innerHTML=out;
}
function line(k){
  var p=k.split('-');
  if(p[0]==='v'){var v=vip[p[1]];return v?{n:v.nama+' (istimewa)',s:v.satuan,h:Number(v.harga)||0}:null}
  var d=D[p[0]],t=d&&d[2][p[1]];
  return t?{n:d[0],s:t[1],h:price(t[0])}:null;
}
var METODE={DP:"Bayar DP",Info:"Info dulu (tanya CS)",Lunas:"Lunas"};
function metode(){var r=document.querySelector('input[name="pm"]:checked');return r?r.value:"Info"}
var lastTotal=0;
function jumlahBayar(m){return m==="DP"?Math.round(lastTotal*DP_PERSEN/100):(m==="Lunas"?lastTotal:0)}
function renderCart(){
  var keys=Object.keys(cart),total=0,count=0,msg=encodeURIComponent("Halo Tomvi Jaya, saya mau pesan:")+"%0A";
  if(user)msg+=encodeURIComponent("Customer istimewa: "+user.nama+(user.wa?" ("+user.wa+")":""))+"%0A";
  g("lines").innerHTML=keys.length?keys.map(function(k){
    var l=line(k),q=cart[k];if(!l)return '';
    var sub=l.h*q;total+=sub;count+=q;msg+=encodeURIComponent("- "+l.n+" ("+l.s+") x"+q)+"%0A";
    return '<div class="line"><span>'+esc(l.n)+' <small>/'+esc(l.s)+'</small></span><b>'+rp(sub)+'</b><span class="qty"><button data-dec="'+k+'" aria-label="Kurangi">−</button> '+q+' <button data-add="'+k+'" aria-label="Tambah">+</button></span></div>';
  }).join(""):"<p class='empty'>Keranjang masih kosong. Tekan + pada produk untuk menambah.</p>";
  g("count").textContent=count;
  g("total").textContent=rp(total);lastTotal=total;
  g("wa").href="https://wa.me/"+WA+"?text="+msg+encodeURIComponent("Total: "+rp(total))+"%0A"+encodeURIComponent("Pembayaran: "+METODE[metode()]+(metode()==="DP"?" ("+DP_PERSEN+"% = "+rp(jumlahBayar("DP"))+")":""));
  showRek();
}
// Info transfer tampil otomatis begitu DP / Lunas dipilih (tidak perlu menunggu klik WhatsApp)
function showRek(){
  var m=metode(),box=g("rek");
  if(m==="Info"||!Object.keys(cart).length){box.style.display="none";return}
  var jml=jumlahBayar(m);
  g("rekAmt").textContent=(m==="DP"?"DP "+DP_PERSEN+"%: ":"Total lunas: ")+rp(jml);
  g("rekNo").textContent=REK_BANK+" "+REK_NO;
  g("rekNm").textContent=REK_NAMA?"a.n. "+REK_NAMA:"";
  var pesan="Halo Tomvi Jaya, saya sudah transfer ("+METODE[m]+" "+rp(jml)+")"+(user?" atas nama "+user.nama:"")+". Berikut bukti transfernya:";
  g("rekWa").href="https://wa.me/"+WA+"?text="+encodeURIComponent(pesan);
  box.style.display="block";
}
g("pay").addEventListener("change",renderCart);
g("rekCopy").onclick=function(){
  var b=g("rekCopy"),ok=function(){b.textContent="Tersalin ✓";setTimeout(function(){b.textContent="Salin nomor rekening"},2000)};
  if(navigator.clipboard&&navigator.clipboard.writeText){navigator.clipboard.writeText(REK_NO).then(ok,function(){b.textContent="Nomor: "+REK_NO})}
  else{b.textContent="Nomor: "+REK_NO}
};
// ---------- Login customer istimewa (dicek ke Google Sheet lewat Apps Script) ----------
function api(body){
  if(!API_URL)return Promise.reject(new Error('API_URL'));
  return fetch(API_URL,{method:'POST',headers:{'Content-Type':'text/plain;charset=utf-8'},body:JSON.stringify(body),keepalive:true}).then(function(r){return r.json()});
}
// Kirim isi keranjang ke sheet Penjualan (jalan di latar belakang, WhatsApp tetap terbuka walau gagal)
var lastSent="";
function kirimPesanan(){
  if(!API_URL)return;
  var items=[];
  Object.keys(cart).forEach(function(k){
    var p=k.split('-'),q=cart[k],produk,satuan;
    if(p[0]==='v'){var v=vip[p[1]];if(!v)return;produk=v.nama;satuan=v.satuan}
    else{var d=D[p[0]],t=d&&d[2][p[1]];if(!t)return;produk=d[0];satuan=t[1]}
    items.push({produk:produk,satuan:satuan,qty:q});
  });
  if(!items.length)return;
  var sig=JSON.stringify(items)+metode();if(sig===lastSent)return;lastSent=sig;
  api({action:'pesan',token:TOKEN,items:items,metode:metode()}).then(function(r){if(!r||!r.ok)lastSent=''}).catch(function(){lastSent=''});
}

// ---------- Nota / invoice setelah pesanan ----------
var notaNo="",notaSig="",notaTgl=null,notaTeks="";
function nomorNota(pre){
  var d=new Date(),p=function(n){return ("0"+n).slice(-2)};
  return pre+String(d.getFullYear()).slice(2)+p(d.getMonth()+1)+p(d.getDate())+"-"+Math.random().toString(36).slice(2,6).toUpperCase();
}
function bukaNota(){
  var rows=[],total=0;
  Object.keys(cart).forEach(function(k){
    var l=line(k),q=cart[k];if(!l)return;
    rows.push({n:l.n,s:l.s,q:q,h:l.h,sub:l.h*q});total+=l.h*q;
  });
  if(!rows.length)return;
  var m=metode(),bayar=m==="DP"?Math.round(total*DP_PERSEN/100):(m==="Lunas"?total:0),sisa=total-bayar;
  var sig=JSON.stringify(rows)+m;
  if(sig!==notaSig){notaSig=sig;notaNo=nomorNota(m==="Lunas"?"NL-":"INV-");notaTgl=new Date()}
  // cantumkan nomor nota di pesan WhatsApp
  renderCart();
  g("wa").href+="%0A"+encodeURIComponent("No. "+(m==="Lunas"?"Nota":"Invoice")+": "+notaNo);
  var tgl=notaTgl.toLocaleString("id-ID",{day:"numeric",month:"long",year:"numeric",hour:"2-digit",minute:"2-digit"});
  var cust=user?user.nama:"Umum";
  var lunas=m==="Lunas",jenis=lunas?"NOTA LUNAS":"INVOICE PENAGIHAN"+(m==="DP"?" (DP)":""),dok=lunas?"Nota":"Invoice";
  var status=lunas?"LUNAS":(m==="DP"?"Menunggu DP "+DP_PERSEN+"%":"Belum dibayar · menunggu konfirmasi CS");
  var rek=REK_BANK+" "+REK_NO+(REK_NAMA?" a.n. "+REK_NAMA:"");
  g("notaJudul").textContent=lunas?"Nota Lunas":"Invoice Penagihan";
  var out='<h3>Tomvi Jaya</h3><div class="sub">Keju &amp; Susu · '+jenis+'</div>'
   +'<div class="meta"><span>No. '+dok+'</span><span><b>'+esc(notaNo)+'</b></span><span>Tanggal</span><span>'+esc(tgl)+'</span><span>Customer</span><span>'+esc(cust)+(user&&user.wa?' ('+esc(user.wa)+')':'')+'</span><span>Status</span><span><span class="stat">'+esc(status)+'</span></span></div>'
   +'<table>'+rows.map(function(r){return '<tr><td>'+esc(r.n)+'<br><small>'+r.q+' '+esc(r.s)+' × '+rp(r.h)+'</small></td><td>'+rp(r.sub)+'</td></tr>'}).join("")
   +'<tr class="tot grand"><td>TOTAL</td><td>'+rp(total)+'</td></tr>';
  if(lunas)out+='<tr class="tot"><td>Dibayar (transfer)</td><td>'+rp(bayar)+'</td></tr><tr class="tot"><td>Sisa tagihan</td><td>'+rp(0)+'</td></tr>';
  else if(m==="DP")out+='<tr class="tot"><td>DP yang harus dibayar ('+DP_PERSEN+'%)</td><td>'+rp(bayar)+'</td></tr><tr class="tot"><td>Sisa pelunasan</td><td>'+rp(sisa)+'</td></tr>';
  else out+='<tr class="tot"><td>Total tagihan</td><td>'+rp(total)+'</td></tr>';
  out+='</table>';
  out+='<div class="rk"><b>'+(lunas?"Pembayaran ke:":"Tagihan dibayar ke:")+'</b><br>'+esc(rek)+'<br><small>'+(lunas?"Kirim bukti transfer ke CS via WhatsApp.":"Setelah transfer, kirim bukti pembayaran ke CS via WhatsApp.")+'</small></div>';
  out+='<div class="ft">'+(lunas?"Terima kasih sudah memesan! Pembayaran dianggap sah setelah dikonfirmasi admin.":"Harga dan ketersediaan barang dikonfirmasi CS. Pesanan diproses setelah pembayaran diterima dan dikonfirmasi admin.")+'</div>';
  g("notaBody").innerHTML=out;g("notaWa").href=g("wa").href;g("notaWa").textContent="Lanjut kirim pesanan ke WhatsApp →";
  notaTeks=jenis+" — Tomvi Jaya\nNo. "+dok+": "+notaNo+"\nTanggal: "+tgl+"\nCustomer: "+cust+"\n\n"
   +rows.map(function(r){return "- "+r.n+" ("+r.s+") "+r.q+" × "+rp(r.h)+" = "+rp(r.sub)}).join("\n")
   +"\n\nTOTAL: "+rp(total)+(m!=="Info"?"\n"+(m==="DP"?"DP yang harus dibayar":"Dibayar")+": "+rp(bayar)+"\nSisa: "+rp(sisa):"")
   +"\nStatus: "+status+"\nPembayaran ke: "+rek;
  g("notaModal").classList.add("open");
}
g("wa").addEventListener("click",function(e){e.preventDefault();bukaNota()});   // nota tampil dulu, WhatsApp belum dibuka
g("notaWa").addEventListener("click",function(){kirimPesanan();g("notaWa").textContent="Buka WhatsApp lagi →"});
g("notaClose").onclick=function(){g("notaModal").classList.remove("open")};
g("notaPrint").onclick=function(){window.print()};
g("notaDone").onclick=function(){
  g("notaModal").classList.remove("open");g("drawer").classList.remove("open");
  cart={};notaSig="";lastSent="";render();renderCart();
};
g("notaCopy").onclick=function(){
  var b=g("notaCopy"),ok=function(){b.textContent="Tersalin ✓";setTimeout(function(){b.textContent="Salin nota"},2000)};
  var fb=function(){var t=document.createElement("textarea");t.value=notaTeks;document.body.appendChild(t);t.select();try{document.execCommand("copy");ok()}catch(e){}document.body.removeChild(t)};
  if(navigator.clipboard&&navigator.clipboard.writeText){navigator.clipboard.writeText(notaTeks).then(ok,fb)}else fb();
};
function saveToken(t){TOKEN=t||'';try{if(t)sessionStorage.setItem('tj_token',t);else sessionStorage.removeItem('tj_token')}catch(e){}}
function renderUser(){
  var t=user?'Halo, '+String(user.nama).split(/\s+/)[0]:null;
  g('vipLg').textContent=t||'Login Istimewa';
  g('vipSm').textContent=t||'Istimewa';
  document.body.classList.toggle('member',!!user);
}
function setUser(r){user={nama:r.nama,wa:r.wa};vip=r.harga||[];cart={};renderUser();render();renderCart()}
function clearUser(){user=null;vip=[];cart={};saveToken('');renderUser();render();renderCart()}
function fail(m){g('vipErr').textContent=m}
function setMode(){
  var akun=!!user;
  g('fForm').style.display=akun?'none':'block';
  g('fAkun').style.display=akun?'block':'none';
  g('vipSave').style.display=akun?'none':'inline-block';
  g('vipOut').style.display=akun?'inline-block':'none';
  g('vipErr').textContent='';
  g('vipTitle').textContent=akun?'Akun istimewa':'Login Customer Istimewa';
  if(akun)g('akunInfo').innerHTML='Masuk sebagai <b>'+esc(user.nama)+'</b>.';
}
function openVip(){setMode();g('vipModal').classList.add('open')}
function closeVip(){g('vipModal').classList.remove('open')}
function doLogin(){
  var u=g('vId').value.trim(),p=g('vPw').value;
  if(!u||!p)return fail('Isi username dan password.');
  var b=g('vipSave');b.disabled=true;b.textContent='Memeriksa...';fail('');
  api({action:'login',username:u,password:p}).then(function(r){
    if(r&&r.ok){saveToken(r.token);setUser(r);g('vPw').value='';closeVip()}
    else fail((r&&r.pesan)||'Login gagal.');
  }).catch(function(e){
    fail(e&&e.message==='API_URL'?'Login belum aktif: API_URL di website belum diisi.':'Tidak bisa terhubung. Coba lagi.');
  }).then(function(){b.disabled=false;b.textContent='Masuk'});
}
g('openVip').onclick=openVip;
g('vipClose').onclick=closeVip;
g('vipSave').onclick=doLogin;
g('vPw').addEventListener('keydown',function(e){if(e.key==='Enter')doLogin()});
g('vipOut').onclick=function(){if(TOKEN&&API_URL)api({action:'logout',token:TOKEN}).catch(function(){});clearUser();closeVip()};
document.addEventListener("click",function(e){
  var a=e.target.closest("[data-add]"),r=e.target.closest("[data-dec]"),c=e.target.closest("[data-cat]");
  if(a){cart[a.dataset.add]=(cart[a.dataset.add]||0)+1;renderCart();if(!g("drawer").classList.contains("open"))showAdd(a.dataset.add);}
  if(r){var k=r.dataset.dec;cart[k]--;if(cart[k]<=0)delete cart[k];renderCart();}
  if(c){cat=c.dataset.cat;render();g("katalog").scrollIntoView();}
});
// Bar kecil di bawah: muncul tiap barang ditambah (nama + harga), klik untuk buka keranjang
var abTimer=null;
function hideAdd(){g("addbar").classList.remove("show");clearTimeout(abTimer)}
function showAdd(k){
  var l=line(k);if(!l)return;
  var n=Object.keys(cart).reduce(function(s,x){return s+cart[x]},0);
  g("abN").textContent="✓ "+l.n;
  g("abP").textContent=rp(l.h)+" /"+l.s+" · jumlah "+cart[k];
  g("abGo").textContent="Keranjang ("+n+") →";
  g("addbar").classList.add("show");
  clearTimeout(abTimer);abTimer=setTimeout(hideAdd,5000);
}
g("addbar").onclick=function(){hideAdd();openCart()};
function openCart(){hideAdd();g("drawer").classList.add("open")}
g("openCart").onclick=openCart;
g("tabCart").onclick=openCart;
g("closeCart").onclick=function(){g("drawer").classList.remove("open")};
g("q").addEventListener("input",function(e){query=e.target.value.toLowerCase().trim();render()});
["heroWa","helpWa","fab"].forEach(function(id){g(id).href="https://wa.me/"+WA});
render();renderCart();renderUser();
try{TOKEN=sessionStorage.getItem('tj_token')||''}catch(e){}
if(TOKEN&&API_URL){api({action:'vip',token:TOKEN}).then(function(r){if(r&&r.ok)setUser(r);else saveToken('')}).catch(function(){})}
