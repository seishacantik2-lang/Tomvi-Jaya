<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Tomvi Jaya — Keju & Susu</title>
<meta name="theme-color" content="#F5B700">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:wght@500;700;800&family=Figtree:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
:root{--y:#F5B700;--y2:#FFD34D;--y-d:#B98300;--y-l:#FFF4CC;--y-xl:#FFFAE8;--bg:#FFFDF6;--surface:#FFFFFF;--ink:#2A2108;--mute:#7A6D4A;--line:#F0E6C2;
--head:'Bricolage Grotesque','Trebuchet MS',sans-serif;--body:'Figtree','Segoe UI',sans-serif;
box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#1B1606;--surface:#262008;--ink:#FFF3C4;--mute:#C9B97F;--line:#3D3410;--y-l:#3A2F05;--y-xl:#2E2606}}
:root[data-theme="dark"]{--bg:#1B1606;--surface:#262008;--ink:#FFF3C4;--mute:#C9B97F;--line:#3D3410;--y-l:#3A2F05;--y-xl:#2E2606}
html{scroll-padding-top:env(safe-area-inset-top,0px);scroll-behavior:smooth}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--ink);font:15px/1.5 var(--body);padding-bottom:84px}
a{color:inherit;text-decoration:none}
button{font-family:inherit}
:focus-visible{outline:3px solid var(--y-d);outline-offset:2px}
.wrap{max-width:1000px;margin:0 auto;padding:0 16px}
header{background:var(--surface);border-bottom:1px solid var(--line);position:sticky;top:env(safe-area-inset-top,0px);z-index:20}
.bar{display:flex;align-items:center;gap:12px;flex-wrap:wrap;padding:10px 0}
.brand{display:flex;align-items:center;gap:10px}
.mark{width:36px;height:36px;border-radius:11px;background:var(--y);display:grid;place-items:center;font:800 15px var(--head);color:#2A2108}
.brand b{display:block;font:700 16px/1.1 var(--head)}.brand small{display:block;font-size:11px;color:var(--mute)}
nav.top{display:none;gap:4px}
nav.top a{padding:7px 14px;border-radius:99px;font-weight:600;font-size:14px;color:var(--mute)}
nav.top a.on,nav.top a:hover{background:var(--y-l);color:var(--ink)}
.search{order:3;flex-basis:100%;position:relative}
.search input{width:100%;padding:11px 16px 11px 40px;border:0;border-radius:99px;background:var(--y-xl);color:var(--ink);font:inherit}
.search span{position:absolute;left:15px;top:9px}
.cartbtn{margin-left:auto;background:#2A2108;color:#FFE27A;border:0;border-radius:99px;padding:9px 16px;font:700 14px var(--body);cursor:pointer;display:flex;gap:8px;align-items:center}
.badge{background:var(--y);color:#2A2108;border-radius:99px;min-width:20px;height:20px;display:grid;place-items:center;font-size:12px;padding:0 5px}
@media(min-width:800px){nav.top{display:flex;margin-left:8px}.search{order:0;flex:1;flex-basis:auto;max-width:340px;margin-left:10px}.cartbtn{margin-left:0}.bar{flex-wrap:nowrap}}
.hero{margin-top:20px;border-radius:26px;background:linear-gradient(120deg,var(--y) 40%,var(--y2));color:#2A2108;padding:30px 26px;display:grid;gap:18px;overflow:hidden;position:relative}
.hero h1{font:800 clamp(30px,6vw,44px)/1.05 var(--head);letter-spacing:-.03em;margin:0}
.hero p{margin:10px 0 0;max-width:44ch;font-weight:500}
.hbtn{display:flex;gap:10px;flex-wrap:wrap;margin-top:18px}
.pill{border:2px solid #2A2108;border-radius:99px;padding:10px 20px;font:700 14px var(--body);cursor:pointer;color:#2A2108;background:transparent;display:inline-block}
.pill.w{background:#fff;border-color:#fff}
.deco{display:none;position:absolute;right:30px;top:50%;transform:translateY(-50%);width:260px;height:180px}
.deco i{position:absolute;display:grid;place-items:center;border-radius:50%;background:rgba(255,255,255,.55);font-style:normal}
@media(min-width:700px){.deco{display:block}.hero{padding:40px 36px}}
h2.t{font:700 22px var(--head);letter-spacing:-.02em;margin:30px 0 12px}
.chips{display:flex;gap:8px;flex-wrap:wrap}
.chip{background:var(--surface);border:1px solid var(--line);border-radius:99px;padding:9px 16px;font:600 14px var(--body);color:var(--ink);cursor:pointer}
.chip:hover{border-color:var(--y)}.chip.on{background:var(--y);border-color:var(--y);color:#2A2108}
.sec{display:flex;justify-content:space-between;align-items:baseline;margin:30px 0 12px}
.sec h2{font:700 22px var(--head);letter-spacing:-.02em;margin:0}
.sec button{background:none;border:0;color:var(--y-d);font:700 13px var(--body);cursor:pointer}
.grid{display:grid;grid-template-columns:repeat(2,1fr);gap:12px}
@media(min-width:620px){.grid{grid-template-columns:repeat(3,1fr)}}@media(min-width:860px){.grid{grid-template-columns:repeat(4,1fr)}}
.card{background:var(--surface);border-radius:20px;padding:0 0 12px;display:flex;flex-direction:column;box-shadow:0 1px 0 var(--line),0 6px 18px rgba(185,131,0,.08);overflow:hidden}
.ph{position:relative;aspect-ratio:1/.82;background:var(--y-xl);display:grid;place-items:center;font-size:44px;padding-bottom:22px}
.ph u{position:absolute;left:0;right:0;bottom:0;height:34px;background:var(--y);border-radius:60% 60% 0 0/100% 100% 0 0;text-decoration:none;font:700 10px/34px var(--body);text-align:center;color:#2A2108}
.card h3{margin:10px 12px 6px;font:600 14px/1.3 var(--body);min-height:2.6em}
.tier{display:flex;justify-content:space-between;align-items:center;gap:6px;font-size:13px;margin:0 12px;padding:5px 0}
.tier b{font-size:14px}.tier small{color:var(--mute)}
.add{background:var(--y);border:0;border-radius:99px;width:28px;height:28px;font:700 17px var(--body);color:#2A2108;cursor:pointer;flex:none}
.add:hover{background:var(--y-d);color:#fff}
.empty{color:var(--mute)}
footer{margin:36px 0 10px;color:var(--mute);font-size:13px;text-align:center}
.fab{position:fixed;right:16px;bottom:calc(78px + env(safe-area-inset-bottom,0px));width:52px;height:52px;border-radius:50%;background:#25D366;display:grid;place-items:center;font-size:24px;box-shadow:0 6px 16px rgba(0,0,0,.25);z-index:30}
.btabs{position:fixed;left:0;right:0;bottom:0;background:var(--surface);border-top:1px solid var(--line);display:flex;justify-content:space-around;padding:8px 0 calc(8px + env(safe-area-inset-bottom,0px));z-index:25}
.btabs a{font:600 11px var(--body);text-align:center;color:var(--mute);padding:2px 14px;cursor:pointer}
.btabs a.on{color:var(--y-d)}.btabs span{display:block;font-size:19px}
@media(min-width:800px){.btabs{display:none}body{padding-bottom:20px}.fab{bottom:20px}}
#drawer{position:fixed;inset:0;background:rgba(0,0,0,.45);display:none;z-index:50}
#drawer.open{display:block}
.panel{position:absolute;right:0;top:0;bottom:0;width:min(400px,100%);background:var(--bg);padding:20px;overflow:auto}
.panel h2{font:700 22px var(--head);display:flex;justify-content:space-between;margin:0 0 8px}
.panel h2 a{font:600 14px var(--body);color:var(--y-d);cursor:pointer}
.line{display:grid;grid-template-columns:1fr auto;gap:4px 10px;padding:10px 0;border-bottom:1px solid var(--line);font-size:14px}
.qty button{width:26px;height:26px;border:1px solid var(--line);background:var(--surface);color:var(--ink);border-radius:50%;cursor:pointer}
.btn{display:inline-block;background:var(--y);color:#2A2108;border-radius:99px;padding:12px 20px;font:700 15px var(--body)}
.acts{margin-left:auto;display:flex;gap:8px;align-items:center}
.acts .cartbtn{margin-left:0}
.vipbtn{background:var(--y-l);color:var(--ink);border:2px solid var(--y);border-radius:99px;padding:7px 14px;font:700 14px var(--body);cursor:pointer;white-space:nowrap}
.vipbtn:hover{background:var(--y)}
.lg{display:none}
@media(min-width:560px){.lg{display:inline}.sm{display:none}}
.modal{position:fixed;inset:0;background:rgba(0,0,0,.5);display:none;z-index:60;align-items:center;justify-content:center;padding:16px}
.modal.open{display:flex}
.mbox{background:var(--bg);border-radius:22px;padding:22px;width:min(420px,100%);max-height:100%;overflow:auto}
.mbox h2{font:700 22px var(--head);display:flex;justify-content:space-between;margin:0 0 6px}
.mbox h2 a{font:600 14px var(--body);color:var(--y-d);cursor:pointer}
.mbox label{display:block;font:600 13px var(--body);margin:12px 0 0}
.mbox input,.mbox textarea{display:block;width:100%;margin-top:4px;padding:11px 13px;border:2px solid var(--line);border-radius:12px;background:var(--surface);color:var(--ink);font:inherit}
.err{color:#B3261E;font-size:13px;min-height:1.2em;margin:10px 0 0}
.mrow{display:flex;gap:10px;margin-top:8px;flex-wrap:wrap}
.mrow .btn{border:0;cursor:pointer}
.vipsec{background:var(--y-xl);border:2px solid var(--y);border-radius:22px;padding:6px 16px 16px;margin-top:22px}
.mtabs{display:flex;gap:6px;margin:12px 0 0}
.mtabs button{flex:1;border:2px solid var(--line);background:var(--surface);color:var(--ink);border-radius:99px;padding:8px;font:700 14px var(--body);cursor:pointer}
.mtabs button.on{background:var(--y);border-color:var(--y);color:#2A2108}
.reg{display:none}
body.member .hero,body.member #chips,body.member .t,body.member .search{display:none}
.mbox .pill{color:var(--ink);border-color:var(--ink)}
#addbar{position:fixed;left:12px;right:12px;bottom:calc(72px + env(safe-area-inset-bottom,0px));z-index:40;max-width:460px;margin:0 auto;background:#2A2108;color:#FFE27A;border:0;border-radius:16px;padding:10px 14px;display:flex;align-items:center;gap:12px;text-align:left;font:inherit;cursor:pointer;box-shadow:0 8px 24px rgba(0,0,0,.3);transform:translateY(16px);opacity:0;pointer-events:none;transition:opacity .2s,transform .2s}
#addbar.show{transform:none;opacity:1;pointer-events:auto}
#addbar .ab-i{flex:1;min-width:0}
#addbar b{display:block;font:700 14px/1.3 var(--body);color:#fff;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
#addbar small{display:block;font-size:13px;color:#FFE27A}
#addbar .ab-go{flex:none;background:var(--y);color:#2A2108;border-radius:99px;padding:8px 14px;font:700 13px var(--body)}
@media(min-width:800px){#addbar{bottom:20px}}
.pay{margin:14px 0 12px;display:flex;gap:8px;flex-wrap:wrap;align-items:center}
.pay>b{flex-basis:100%;font:700 14px var(--body)}
.po{flex:1;min-width:0;cursor:pointer}
.po input{position:absolute;opacity:0;pointer-events:none}
.po span{display:block;text-align:center;border:2px solid var(--line);background:var(--surface);color:var(--ink);border-radius:99px;padding:9px 6px;font:700 13px var(--body);white-space:nowrap}
.po input:checked+span{background:var(--y);border-color:var(--y);color:#2A2108}
.po input:focus-visible+span{outline:3px solid var(--y-d);outline-offset:2px}
.rek{margin-top:16px;background:var(--y-xl);border:2px solid var(--y);border-radius:18px;padding:14px 16px}
.rek .no{font:800 24px/1.2 var(--head);letter-spacing:.02em;margin:6px 0 2px}
.rek .mrow .pill{color:var(--ink);border-color:var(--ink);padding:8px 16px}
.rek p{margin:10px 0}
.payhd{font:700 14px var(--body);margin:14px 0 6px}
.payopts{display:flex;gap:6px}
.payopts button{flex:1;border:2px solid var(--line);background:var(--surface);color:var(--ink);border-radius:99px;padding:9px 6px;font:700 14px var(--body);cursor:pointer}
.payopts button.on{background:var(--y);border-color:var(--y);color:#2A2108}
.paynote{font-size:13px;color:var(--mute);margin:8px 0 14px;min-height:2.6em}
.done{list-style:none;padding:0;margin:10px 0}
.done li{padding:8px 0;border-bottom:1px solid var(--line);font-size:14px}
.done li:last-child{border:0}
.rek{background:var(--y-xl);border:2px dashed var(--y);border-radius:14px;padding:10px 12px;margin:10px 0;font-weight:600;white-space:pre-line}
/* ---- Nota / invoice ---- */
#notaModal{z-index:70}
.nota{background:#fff;color:#2A2108;border:1px dashed #B98300;border-radius:14px;padding:16px;font:13px/1.45 var(--body)}
.nota h3{margin:0;font:800 20px var(--head);text-align:center}
.nota .sub{text-align:center;color:#7A6D4A;font-size:12px;margin-bottom:10px}
.nota .meta{display:grid;grid-template-columns:auto 1fr;gap:2px 12px;font-size:12px;border-top:1px dashed #B98300;border-bottom:1px dashed #B98300;padding:8px 0;margin:8px 0}
.nota .meta span:nth-child(odd){color:#7A6D4A}
.nota table{width:100%;border-collapse:collapse}
.nota td{padding:5px 0;vertical-align:top;border-bottom:1px solid #F0E6C2}
.nota td:last-child{text-align:right;white-space:nowrap;padding-left:8px}
.nota .tot td{border:0;font-weight:700}
.nota .grand td{font-size:15px;font-weight:800;border-top:2px solid #2A2108}
.nota .stat{display:inline-block;padding:2px 10px;border-radius:99px;background:#FFF4CC;font-weight:700}
.nota .rk{margin-top:10px;padding:8px 10px;background:#FFFAE8;border-radius:10px}
.nota .ft{margin-top:10px;text-align:center;color:#7A6D4A;font-size:11px}
@media print{body>*:not(#notaModal){display:none!important}#notaModal{position:static;display:block;background:none;padding:0}#notaModal .mbox{width:100%;max-height:none;overflow:visible;padding:0;background:#fff}.noprint{display:none!important}}
@media(prefers-reduced-motion:reduce){*{transition:none!important;scroll-behavior:auto!important}}
</style>
</head>
